# 模型服务 API 密钥。不要把真实密钥提交到代码仓库。
ARK_API_KEY=

# ARK_MODEL 兼容旧配置，并作为轻量模型后备。首版建议使用：
# Mini（低成本澄清和目的地初筛）→ Lite（普通行程回答）→ Pro（多约束推理）。
# 推理档会启用深度思考，其他档位会关闭。
ARK_MODEL=
ARK_MODEL_SMALL=doubao-seed-2-0-mini-260428
ARK_MODEL_GENERAL=doubao-seed-2-0-lite-260428
ARK_MODEL_REASONING=doubao-seed-2-0-pro-260215

# 模型服务调用地址。一般不需要修改。
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/responses

# 可选：高德 Web 服务 API Key，用于把公交、地铁、步行和跨城路线数据直接回填到页面。
# 未配置时，页面仍会展示模型给出的交通方式和区间估算，并提供可选导航入口；
# 不会把估算包装成已核验的实时路线。
AMAP_MAPS_API_KEY=
