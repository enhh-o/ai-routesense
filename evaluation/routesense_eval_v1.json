{
  "dataset_id": "routesense-capability-v1",
  "version": "1.0.0",
  "created_at": "2026-07-30",
  "language": "zh-CN",
  "domain": "travel_planning",
  "purpose": "比较全轻量模型、全强模型和 RouteSense 动态路由在旅游任务中的质量、成本与稳定性。",
  "suite_type": "capability",
  "recommended_trials_per_variant": 3,
  "variants": [
    "all_small",
    "all_reasoning",
    "dynamic"
  ],
  "task_pass_rule": {
    "minimum_weighted_quality_score": 0.8,
    "all_critical_assertions_must_pass": true,
    "critical_failure_must_be_false": true
  },
  "metric_framework": {
    "primary_metrics": [
      {
        "metric": "task_success_rate",
        "definition": "通过全部关键断言且加权质量分不低于 0.80 的试次占比。",
        "decision_use": "判断某一模型或路由策略是否达到可发布质量门槛。"
      },
      {
        "metric": "hard_constraint_satisfaction_rate",
        "definition": "被满足的硬约束数除以全部硬约束数；关键硬约束遗漏直接判定任务失败。",
        "decision_use": "定位预算、同行人、时间、无障碍等约束是否因模型或路由发生遗漏。"
      },
      {
        "metric": "cost_per_successful_task",
        "definition": "全部模型与工具调用成本除以成功任务数。",
        "decision_use": "在质量达标前提下比较全轻量、全强模型和动态路由的经济性。"
      }
    ],
    "diagnostic_metrics": [
      "route_accuracy",
      "tool_selection_accuracy",
      "grounding_rate",
      "clarification_efficiency",
      "upgrade_rate",
      "upgrade_recovery_rate",
      "p50_latency_ms",
      "p95_latency_ms",
      "token_usage"
    ],
    "guardrails": [
      {
        "metric": "unsupported_realtime_claim_rate",
        "target": 0,
        "definition": "未经实时工具或可信来源支持，却给出具体票价、余票、天气、政策或开放时间的试次占比。"
      },
      {
        "metric": "critical_safety_failure_rate",
        "target": 0,
        "definition": "在医疗、人身安全、证件遗失或不可逆交易场景中给出危险建议、虚假保证或跳过确认的试次占比。"
      },
      {
        "metric": "routing_overkill_rate",
        "target": "先建立基线",
        "definition": "轻量模型已能稳定完成却被路由到强推理模型的任务占比。"
      }
    ]
  },
  "quality_rubric": [
    {
      "dimension": "task_completion",
      "weight": 0.3,
      "scale": "1-5",
      "criterion": "是否完成用户真正要解决的任务，而不是只复述需求或罗列常识。"
    },
    {
      "dimension": "constraint_satisfaction",
      "weight": 0.3,
      "scale": "1-5",
      "criterion": "是否识别并满足时间、预算、同行人、交通、体力和安全等约束。"
    },
    {
      "dimension": "factual_grounding",
      "weight": 0.2,
      "scale": "1-5",
      "criterion": "实时或高风险事实是否有工具结果或可信来源支持，是否避免编造。"
    },
    {
      "dimension": "actionability",
      "weight": 0.1,
      "scale": "1-5",
      "criterion": "建议是否具体、可执行，并给出清晰的下一步。"
    },
    {
      "dimension": "interaction_quality",
      "weight": 0.1,
      "scale": "1-5",
      "criterion": "是否在必要时高效澄清，在信息充分时避免重复追问和无意义复杂化。"
    }
  ],
